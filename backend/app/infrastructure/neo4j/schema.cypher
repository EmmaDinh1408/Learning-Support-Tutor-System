CREATE CONSTRAINT user_id_unique IF NOT EXISTS FOR (n:User) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT user_email_unique IF NOT EXISTS FOR (n:User) REQUIRE n.email IS UNIQUE;
CREATE INDEX user_role_idx IF NOT EXISTS FOR (n:User) ON (n.role);
CREATE CONSTRAINT course_id_unique IF NOT EXISTS FOR (n:Course) REQUIRE n.id IS UNIQUE;
CREATE INDEX course_code_idx IF NOT EXISTS FOR (n:Course) ON (n.code);
CREATE INDEX course_semester_year_idx IF NOT EXISTS FOR (n:Course) ON (n.semester, n.year);
CREATE CONSTRAINT enrollment_id_unique IF NOT EXISTS FOR (n:Enrollment) REQUIRE n.id IS UNIQUE;
CREATE INDEX enrollment_status_idx IF NOT EXISTS FOR (n:Enrollment) ON (n.status);
CREATE CONSTRAINT assignment_id_unique IF NOT EXISTS FOR (n:Assignment) REQUIRE n.id IS UNIQUE;
CREATE INDEX assignment_due_idx IF NOT EXISTS FOR (n:Assignment) ON (n.dueAt);
CREATE CONSTRAINT submission_id_unique IF NOT EXISTS FOR (n:Submission) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT announcement_id_unique IF NOT EXISTS FOR (n:Announcement) REQUIRE n.id IS UNIQUE;
CREATE INDEX announcement_global_idx IF NOT EXISTS FOR (n:Announcement) ON (n.isGlobal, n.status);
CREATE CONSTRAINT attendance_session_id_unique IF NOT EXISTS FOR (n:AttendanceSession) REQUIRE n.id IS UNIQUE;
CREATE INDEX attendance_session_date_idx IF NOT EXISTS FOR (n:AttendanceSession) ON (n.date);
CREATE CONSTRAINT attendance_record_id_unique IF NOT EXISTS FOR (n:AttendanceRecord) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT quiz_id_unique IF NOT EXISTS FOR (n:Quiz) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT quiz_attempt_id_unique IF NOT EXISTS FOR (n:QuizAttempt) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT quiz_question_id_unique IF NOT EXISTS FOR (n:QuizQuestion) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT quiz_response_id_unique IF NOT EXISTS FOR (n:QuizResponse) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT learning_node_id_unique IF NOT EXISTS FOR (n:LearningNode) REQUIRE n.id IS UNIQUE;
CREATE INDEX learning_node_status_idx IF NOT EXISTS FOR (n:LearningNode) ON (n.status);
CREATE CONSTRAINT learning_cluster_id_unique IF NOT EXISTS FOR (n:LearningCluster) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT learning_outcome_id_unique IF NOT EXISTS FOR (n:LearningOutcome) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT section_id_unique IF NOT EXISTS FOR (n:Section) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT resource_id_unique IF NOT EXISTS FOR (n:LearningResource) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT file_id_unique IF NOT EXISTS FOR (n:CourseFile) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT grade_item_id_unique IF NOT EXISTS FOR (n:GradeItem) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT conversation_id_unique IF NOT EXISTS FOR (n:Conversation) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT message_id_unique IF NOT EXISTS FOR (n:Message) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT notification_id_unique IF NOT EXISTS FOR (n:Notification) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT revoked_token_id_unique IF NOT EXISTS FOR (n:RevokedToken) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT home_slide_id_unique IF NOT EXISTS FOR (n:HomeSlide) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT login_stat_id_unique IF NOT EXISTS FOR (n:LoginStat) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT recommendation_id_unique IF NOT EXISTS FOR (n:Recommendation) REQUIRE n.id IS UNIQUE;

