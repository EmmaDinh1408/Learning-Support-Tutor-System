# Neo4j (Graph Database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-long-random-password
NEO4J_DATABASE=neo4j

# PostgreSQL (Transactional DB, doc_chunk, ai_proposal_item, outbox_events)
POSTGRES_DB=g4lms
POSTGRES_USER=g4lms
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DSN=postgresql://g4lms:replace-with-postgres-password@localhost:5432/g4lms

# Redis (LLM Cache, Course Content Cache, Job Queue)
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 (Object Storage for PDF, Slide, Media)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace-with-minio-secret
S3_BUCKET=g4lms-materials

# External LLM & AI Gateway (optional - falls back to deterministic extractor if empty)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# Security & CORS
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
